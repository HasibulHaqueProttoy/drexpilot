# Environment configuration for PostPilot (Drex SMM)

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (Supabase or Local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postpilot

# Encryption Key for OAuth Tokens (32 bytes hex string = 64 characters)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session / Cookie Secret
COOKIE_SECRET=change_this_to_a_secure_random_string_32_chars_min

# LinkedIn OAuth 2.0 Credentials
# Get these from LinkedIn Developer Portal (Developer Portal -> App -> Auth)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback

# Default Application Timezone (User configurable)
DEFAULT_TIMEZONE=Asia/Dhaka

# MCP Security
# Optional API key for authenticating incoming MCP requests over HTTP
MCP_API_KEY=postpilot-mcp-secret-key-12345

# Frontend URL (For CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000
